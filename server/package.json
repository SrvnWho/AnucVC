    "ram:watch": "node pm2-ram.js --watch"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.8",
    "socket.io": "^4.8.4",
    "werift": "^0.24.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
