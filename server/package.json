{
  "name": "anucvc-server",
  "version": "1.0.0",
  "description": "Ultra-lightweight Fastify + Socket.io + SQLite backend server for AnucVC",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/security.test.js",
