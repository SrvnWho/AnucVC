# Copy to server/.env and fill in what you need. Every value here is optional -
# the server starts with sensible defaults if the file doesn't exist at all.
# server/.env is gitignored: real keys must never be committed.

# Port the Fastify/Socket.io server listens on.
PORT=8080

# Interface to bind. Use 127.0.0.1 when a reverse proxy / Cloudflare Tunnel
# runs on the same machine, so the app port isn't reachable directly.
# HOST=0.0.0.0

# Secret used to sign login session tokens (at least 32 characters).
# If unset, a random one is generated on first start and stored in
# server/.auth-secret (gitignored). Changing it logs every user out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# AUTH_SECRET=

# GIPHY API key for the GIF picker (https://developers.giphy.com/dashboard/).
# Only the server uses it - clients search through GET /api/gifs. The GIF
# picker shows "not configured" while this is empty.
# GIPHY_API_KEY=

# Where the AnucAI Python microservice (ai-service/) is reachable.
AI_SERVICE_URL=http://127.0.0.1:8001

# Optional: use a database file somewhere other than server/anucvc.db.
# ANUCVC_DB_PATH=

# Shared secret for the CI-only desktop-updater upload endpoint
# (POST /api/updates/upload). Uploads are refused entirely while it is unset.
# UPDATE_UPLOAD_SECRET=

# --- WebRTC TURN relay (optional) -------------------------------------------
# Voice works over STUN alone for most people. A TURN relay is only needed for
# users behind a symmetric NAT, where a direct peer-to-peer path can't be
# negotiated at all. Set these and both the browser/desktop clients and the
# server-relayed CS2 ROOM pick the relay up automatically - clients read it
# from GET /api/ice-servers, so no rebuild is needed.
#
# TURN_URL accepts several comma-separated URLs.
# TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349?transport=tcp
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-password
